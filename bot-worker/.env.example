# ─────────────────────────────────────────────
# BOT-ANDRO Bot Worker — .env config (Termux)
# Salin file ini ke .env dan sesuaikan nilainya
# ─────────────────────────────────────────────

# ADB binary dari android-tools Termux (jangan diubah kecuali install manual)
ADB_PATH=adb

# Serial device lokal — ADB over WiFi ke diri sendiri
# Android 10 : biasanya 127.0.0.1:5555
# Android 11+: cek port di Settings → Wireless Debugging
# Untuk cek: jalankan 'adb devices' di Termux setelah connect
DEVICE_SERIAL=127.0.0.1:5555

# Folder output (path Linux Termux)
OUTPUT_BASE_DIR=/data/data/com.termux/files/home/BOT-ANDRO/bot-worker/output

# Format screenshot
SCREENSHOT_FORMAT=png

# Timing (detik)
ACTION_DELAY=1.0
TASK_TIMEOUT=300
