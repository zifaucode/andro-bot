# ─────────────────────────────────────────────
# BOT-ANDRO FastAPI Server — .env config (Termux)
# Salin file ini ke .env dan sesuaikan nilainya
# ─────────────────────────────────────────────

# API Key — WAJIB diganti! (Laravel harus kirim header ini: X-API-Key: <nilai ini>)
API_KEY=ganti_dengan_api_key_rahasia

# Bot Worker Path (otomatis diisi oleh setup_termux.sh)
BOT_WORKER_PATH=/data/data/com.termux/files/home/BOT-ANDRO/bot-worker/worker.py
PYTHON_EXE=python

# Job status file
JOB_STATUS_PATH=/data/data/com.termux/files/home/BOT-ANDRO/fastapi-server/job_status.json

# CORS — izinkan semua origin (atau batasi ke domain Laravel Anda)
ALLOWED_ORIGINS=*

# Server
HOST=0.0.0.0
PORT=8000

# Dashboard login
DASHBOARD_USER=admin
DASHBOARD_PASS=admin123

# Cloudflare URL — diisi otomatis oleh start.sh saat tunnel aktif
# Tidak perlu diubah manual
CLOUDFLARE_URL=http://localhost:8000
